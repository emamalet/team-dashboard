# Only PORT is mandatory. Each tab is enabled when all of its variables are set (Git, Pipelines, Jira, Versions);
# otherwise it shows which variables to fill in. See the README for the list per tab.

# Server
PORT=3000
COMMITS_PER_DEV=10

# GitLab (token with the read_api scope)
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=123
# Project path in the GitLab URL (used for commit links)
GITLAB_PROJECT_PATH=group/project
# Project whose pipelines represent deployments
GITLAB_DEPLOY_PROJECT_ID=456

# Deployment pipeline variables: target environment and deployed version (the first one set wins)
DEPLOY_ENV_VARIABLES=DEPLOY_ENV
DEPLOY_VERSION_VARIABLES=VERSION_TAG
# Displayed label -> environment variable value (JSON)
DEPLOY_ENVIRONMENTS={"Recette 1":"env-1","Recette 2":"env-2"}

# Jira (Atlassian API token)
JIRA_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=
JIRA_PROJECT=KEY
# Display order of statuses for issues with a version (comma-separated)
JIRA_STATUS_ORDER=To Do,In Progress,In Review,Done
# Estimation fields (Jira field ids) and divisors converting their value to days (1 = already in days, 28800 = seconds with 8h days)
JIRA_DEV_ESTIMATE_FIELD=timeestimate
JIRA_TEST_ESTIMATE_FIELD=customfield_10150
JIRA_DEV_ESTIMATE_DIVISOR=28800
JIRA_TEST_ESTIMATE_DIVISOR=1

# Delivery forecast: team size, working days per week (Monday first), range applied to unestimated issues (days)
TEAM_DEVS=4.5
TEAM_TESTERS=1
WORK_DAYS_PER_WEEK=5
UNESTIMATED_MIN_DAYS=1
UNESTIMATED_MAX_DAYS=3
